#!/bin/zsh
# update-icons — Re-apply custom app icons after updates.
#
# Place custom icons in ~/Icons/, or let a dotfiles layer place them in ~/.local/share/app-icons/,
# named as kebab-case of the app name:
#   example-app.icns  →  Example App.app
#
# For edge cases, add overrides in ~/Icons/.mappings:
#   example=/Users/you/Applications/Example App.app
#
# Usage: update-icons [--force] [--dry-run]

set -eo pipefail

ICONS_DIR="${ICONS_DIR:-$HOME/Icons}"
LAYER_ICONS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/app-icons"
DATA_DIR="$ICONS_DIR/.data"
MAPPINGS_FILE="$ICONS_DIR/.mappings"

FORCE=false
DRY_RUN=false
RESTORE=false

for arg in "$@"; do
    case "$arg" in
        --force)   FORCE=true ;;
        --dry-run) DRY_RUN=true ;;
        --reset)
            print "Removing stored hashes and acceptance markers..."
            rm -f "$DATA_DIR"/*.hash(N) "$DATA_DIR"/*.accepted(N)
            print "Done. Next run will prompt for all apps."
            exit 0
            ;;
        --restore) RESTORE=true ;;
        --help|-h)
            print "Usage: update-icons [--force] [--dry-run] [--reset] [--restore]"
            print ""
            print "Apply custom icons from $ICONS_DIR and $LAYER_ICONS_DIR to matching macOS apps."
            print ""
            print "Options:"
            print "  --force     Apply custom icons without prompting"
            print "  --dry-run   Show what would happen without making changes"
            print "  --reset     Remove all stored hashes and acceptance markers"
            print "  --restore   Remove custom icons, restoring provider originals"
            print ""
            print "Icon naming: <app-name>.icns or .png"
            print "  example-app.icns  →  Example App.app"
            print ""
            print "Override auto-detection in $MAPPINGS_FILE:"
            print "  example=/Users/you/Applications/Example App.app"
            exit 0
            ;;
        *) print "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

# ── Helpers ───────────────────────────────────────────────────────

msg()  { print "\033[1;34m$1\033[0m" }
ok()   { print "\033[32m✓\033[0m $1" }
warn() { print "\033[1;33m⚠\033[0m  $1" }
err()  { print "\033[31m✗\033[0m $1" }
dim()  { print "    \033[2m$1\033[0m" }

mkdir -p "$DATA_DIR/provider-icons"

# ── Dependency check ──────────────────────────────────────────────

if ! command -v fileicon &>/dev/null; then
    err "fileicon not found. Install with: brew install fileicon"
    exit 1
fi

# ── Find app for a given icon stem ────────────────────────────────

find_app() {
    local stem="$1"

    # 1. Check manual mappings file
    if [[ -f "$MAPPINGS_FILE" ]]; then
        local mapped
        mapped=$(command grep -m1 "^${stem}=" "$MAPPINGS_FILE" 2>/dev/null | cut -d= -f2-)
        if [[ -n "$mapped" && -d "$mapped" ]]; then
            print "$mapped"
            return 0
        fi
    fi

    # 2. Auto-discover by normalizing names
    local with_spaces="${stem//-/ }"
    local no_sep_stem="${stem//-/}"
    no_sep_stem="${(L)no_sep_stem}"

    local app_path app_name app_no_sep
    for app_path in /Applications/*.app(N) /Applications/*/*.app(N) \
                    ~/Applications/*.app(N) ~/Applications/*/*.app(N); do
        [[ -d "$app_path" ]] || continue
        app_name="${${app_path:t}%.app}"

        # Case-insensitive match (hyphens → spaces)
        [[ "${(L)app_name}" == "${(L)with_spaces}" ]] && { print "$app_path"; return 0 }

        # Normalized match (strip all spaces + hyphens, lowercase)
        app_no_sep="${app_name// /}"
        [[ "${(L)app_no_sep}" == "$no_sep_stem" ]] && { print "$app_path"; return 0 }
    done

    return 1
}

# ── Read the provider's icon file from the app bundle ─────────────

get_bundle_icon() {
    local app_path="$1"
    local plist="$app_path/Contents/Info.plist"
    [[ -f "$plist" ]] || return 1

    local icon_file
    icon_file=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIconFile" "$plist" 2>/dev/null) || return 1

    # Append .icns if missing extension
    [[ "$icon_file" == *.* ]] || icon_file="${icon_file}.icns"

    local path="$app_path/Contents/Resources/$icon_file"
    [[ -f "$path" ]] && print "$path" && return 0
    return 1
}

# ── Set icon, retry with sudo on permission failure ───────────────

_report_icon_error() {
    local err_out="$1"
    print ""
    dim "$err_out"
    if [[ "$err_out" == *"not permitted"* || "$err_out" == *"write permissions"* ]]; then
        dim "Hint: grant your terminal 'App Management' in System Settings → Privacy & Security, then re-run."
    fi
}

set_icon() {
    local app_path="$1" icon_file="$2" err_out
    err_out=$(fileicon set "$app_path" "$icon_file" 2>&1) && return 0
    print -n "\033[2msudo...\033[0m "
    err_out=$(sudo fileicon set "$app_path" "$icon_file" 2>&1) && return 0
    _report_icon_error "$err_out"
    return 1
}

remove_icon() {
    local app_path="$1" err_out
    err_out=$(fileicon rm "$app_path" 2>&1) && return 0
    print -n "\033[2msudo...\033[0m "
    err_out=$(sudo fileicon rm "$app_path" 2>&1) && return 0
    _report_icon_error "$err_out"
    return 1
}

# ── Prompt user when provider shipped a new icon ──────────────────

prompt_user() {
    local app_name="$1" bundle_icon="$2" custom_icon="$3"

    warn "Provider shipped a new icon for \033[1m$app_name\033[0m"
    dim "Opening both icons for comparison (provider | custom)..."

    # Copy to temp files with descriptive names so qlmanage title indicates role
    local tmpdir=""
    tmpdir=$(mktemp -d)
    local bundle_ext="${bundle_icon:e}"
    local custom_ext="${custom_icon:e}"
    cp "$bundle_icon" "$tmpdir/Provider.${bundle_ext}"
    cp "$custom_icon" "$tmpdir/Custom.${custom_ext}"
    qlmanage -p "$tmpdir/Provider.${bundle_ext}" "$tmpdir/Custom.${custom_ext}" &>/dev/null &
    local ql_pid=$!

    print ""
    local answer=""
    read "answer?    Apply your custom icon? [y/N] "

    kill $ql_pid 2>/dev/null
    wait $ql_pid 2>/dev/null
    rm -rf "$tmpdir"

    [[ "$answer" == [yY] ]]
}

# ── Main ──────────────────────────────────────────────────────────

main() {
    print "\033[1mApp Icon Manager\033[0m"
    $DRY_RUN && print "\033[2m(dry run — no changes will be made)\033[0m"
    $RESTORE && print "\033[2m(restore mode — removing custom icons)\033[0m"
    print ""

    # ── Restore mode: remove custom icons from all apps ──
    if $RESTORE; then
        local restored=0 scanned=0
        for app_path in /Applications/*.app(N) /Applications/*/*.app(N) \
                        ~/Applications/*.app(N) ~/Applications/*/*.app(N); do
            [[ -d "$app_path" ]] || continue
            # Check if app has a custom icon set
            fileicon test "$app_path" &>/dev/null || continue
            scanned=$((scanned + 1))

            local app_name="${${app_path:t}%.app}"

            if $DRY_RUN; then
                ok "$app_name — would restore provider icon"
            else
                print -n "    $app_name — restoring provider icon... "
                if remove_icon "$app_path"; then
                    print "\033[32mdone\033[0m"
                    restored=$((restored + 1))
                else
                    print "\033[31mfailed\033[0m"
                fi
            fi
        done

        if [[ $scanned -eq 0 ]]; then
            dim "No apps with custom icons found."
        fi

        print ""
        msg "Done: $restored restored out of $scanned with custom icons"

        if ! $DRY_RUN; then
            rm -f "$DATA_DIR"/*.hash(N) "$DATA_DIR"/*.accepted(N)
            dim "Cleared stored hashes."
            if [[ $restored -gt 0 ]]; then
                print ""
                dim "Restarting Dock to refresh icons..."
                killall Dock 2>/dev/null || true
            fi
        fi
        return 0
    fi

    local applied=0 changed=0 skipped=0 not_found=0
    local dock_restart=false

    for icon_file in "$ICONS_DIR"/*.icns(N) "$ICONS_DIR"/*.png(N) "$LAYER_ICONS_DIR"/*.icns(N) "$LAYER_ICONS_DIR"/*.png(N); do
        local filename="${icon_file:t}"
        local stem="${filename%.*}"

        # Skip non-app icons (folder icons, Finder metadata)
        [[ "$stem" == *folder* || "$stem" == Icon* ]] && continue

        # Find the matching app
        local app_path=""
        if ! app_path=$(find_app "$stem"); then
            dim "No app found for $filename"
            not_found=$((not_found + 1))
            continue
        fi

        local app_name="${${app_path:t}%.app}"

        # Get the provider's original icon from inside the bundle
        # (NSWorkspace.setIcon writes to extended attributes, never modifies this file)
        local bundle_icon=""
        if ! bundle_icon=$(get_bundle_icon "$app_path"); then
            err "$app_name — cannot read bundle icon"
            skipped=$((skipped + 1))
            continue
        fi

        # Hash the provider icon
        local current_hash=""
        current_hash=$(shasum -a 256 "$bundle_icon" | cut -d' ' -f1)

        # Archive unique provider icons
        local prov_dir="$DATA_DIR/provider-icons/$stem"
        mkdir -p "$prov_dir"
        local ext="${bundle_icon:e}"
        if [[ ! -f "$prov_dir/${current_hash}.${ext}" ]]; then
            cp "$bundle_icon" "$prov_dir/${current_hash}.${ext}"
        fi

        # Load stored state
        local hash_file="$DATA_DIR/${stem}.hash"
        local accepted_file="$DATA_DIR/${stem}.accepted"
        local stored_hash=""
        [[ -f "$hash_file" ]] && stored_hash=$(<"$hash_file")

        # If user previously accepted the provider icon, skip (unless --force)
        if [[ -f "$accepted_file" ]] && ! $FORCE; then
            local accepted_hash=$(<"$accepted_file")
            if [[ "$current_hash" == "$accepted_hash" ]]; then
                dim "$app_name — using accepted provider icon"
                skipped=$((skipped + 1))
                continue
            else
                # Provider changed again since acceptance — re-evaluate
                rm -f "$accepted_file"
            fi
        fi
        $FORCE && rm -f "$accepted_file"

        if [[ "$current_hash" == "$stored_hash" ]]; then
            # ── Provider icon unchanged → apply custom icon silently ──
            if $DRY_RUN; then
                ok "$app_name — would apply custom icon"
            else
                print -n "    $app_name — applying custom icon... "
                if set_icon "$app_path" "$icon_file"; then
                    print "\033[32mdone\033[0m"
                    applied=$((applied + 1))
                    dock_restart=true
                else
                    print "\033[31mfailed\033[0m"
                fi
            fi
        else
            # ── New icon or provider changed → prompt user ──
            changed=$((changed + 1))

            if $FORCE; then
                if ! $DRY_RUN; then
                    print -n "$current_hash" > "$hash_file"
                    print -n "    $app_name — applying custom icon... "
                    if set_icon "$app_path" "$icon_file"; then
                        print "\033[32mdone\033[0m"
                        applied=$((applied + 1))
                        dock_restart=true
                    else
                        print "\033[31mfailed\033[0m"
                    fi
                else
                    ok "$app_name — would apply custom icon (forced)"
                fi
            elif $DRY_RUN; then
                warn "$app_name — provider icon changed (would prompt)"
            else
                print ""
                if prompt_user "$app_name" "$bundle_icon" "$icon_file"; then
                    print -n "$current_hash" > "$hash_file"
                    print -n "    $app_name — applying custom icon... "
                    if set_icon "$app_path" "$icon_file"; then
                        print "\033[32mdone\033[0m"
                        applied=$((applied + 1))
                        dock_restart=true
                    else
                        print "\033[31mfailed\033[0m"
                    fi
                else
                    ok "Keeping provider icon for $app_name"
                    print -n "$current_hash" > "$hash_file"
                    print -n "$current_hash" > "$accepted_file"
                    skipped=$((skipped + 1))
                fi
            fi
        fi
    done

    print ""
    msg "Done: $applied applied, $changed new/changed, $skipped skipped, $not_found unmatched"

    if $dock_restart && ! $DRY_RUN; then
        print ""
        dim "Restarting Dock to refresh icons..."
        killall Dock 2>/dev/null || true
    fi
}

main "$@"
