#!/data/data/com.termux/files/usr/bin/bash
# Runs a command through termux-chroot with every argument exactly as given, because termux-chroot runs sh -c "$*"
# /usr/bin/pkg exists only inside the chroot, and a second proot there only costs start-up time
[ -e /usr/bin/pkg ] && exec "$@"
quoted=
for arg in "$@"; do
    quoted="$quoted '${arg//\'/\'\\\'\'}'"
done
# termux-chroot sets HOME to /home, which is always the real home, so another HOME, such as a test's, goes in with the command
keep_home=
if [ "$(cd "$HOME" 2>/dev/null && pwd -P)" != "$(cd "${PREFIX:-/data/data/com.termux/files/usr}/../home" && pwd -P)" ]; then
    keep_home="HOME='${HOME//\'/\'\\\'\'}'; "
fi
exec termux-chroot "${keep_home}exec$quoted"
