[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      // "j k": "vim::SwitchToNormalMode"
    }
  }{{ if eq .chezmoi.os "darwin" -}}
  ,
  {
    "context": "Terminal",
    "bindings": {
      "cmd-shift-left":  ["terminal::SendText", "\u001b[1;10D"],
      "cmd-shift-right": ["terminal::SendText", "\u001b[1;10C"],
      "cmd-a":           ["terminal::SendText", "\u001b[97;9~"],
      "cmd-x":           ["terminal::SendText", "\u001b[120;9~"]
    }
  }
  {{- end }}
]
