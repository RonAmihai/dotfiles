sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name = "Ron Amihai"
    work_dotfiles_repo = {{ promptStringOnce . "work_dotfiles_repo" "Work dotfiles repo URL for a second chezmoi (empty for none)" "" | quote }}
    dotfiles_layers = {{ promptStringOnce . "dotfiles_layers" "More dotfiles layers as name=URL pairs separated by spaces (empty for none)" "" | quote }}

[diff]
    exclude = ["scripts"]

{{ if eq .chezmoi.os "windows" -}}
[interpreters.ps1]
    command = "powershell.exe"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{ end -}}
